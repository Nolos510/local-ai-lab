# Core app
LOCAL_AI_LAB_APP_NAME=local-ai-lab
LOCAL_AI_LAB_ENV=local

# Qdrant runs in Docker by default.
LOCAL_AI_LAB_QDRANT_URL=http://localhost:6333
LOCAL_AI_LAB_QDRANT_COLLECTION=local_ai_lab_chunks
LOCAL_AI_LAB_QDRANT_VECTOR_SIZE=1024

# Deterministic embeddings keep offline tests reproducible.
# Use ollama for semantic local embeddings once the model is installed.
# Switching vector size/model requires dropping/recreating the Qdrant collection
# and reingesting documents so vector spaces do not mix.
LOCAL_AI_LAB_EMBEDDING_PROVIDER=deterministic
LOCAL_AI_LAB_OLLAMA_EMBEDDING_MODEL=bge-m3

# Qdrant is the v0 vector store.
LOCAL_AI_LAB_VECTOR_STORE_PROVIDER=qdrant

# Choose one: ollama, lm_studio, openai_compatible, mock
LOCAL_AI_LAB_LLM_PROVIDER=ollama
LOCAL_AI_LAB_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_AI_LAB_OLLAMA_MODEL=qwen3:14b
LOCAL_AI_LAB_LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Paste an actual id from the LM Studio /models endpoint. Do not include angle brackets.
LOCAL_AI_LAB_LM_STUDIO_MODEL=paste-model-id-here

# RAG defaults
LOCAL_AI_LAB_TOP_K=5
LOCAL_AI_LAB_CHUNK_SIZE=900
LOCAL_AI_LAB_CHUNK_OVERLAP=120
LOCAL_AI_LAB_REQUEST_TIMEOUT_SECONDS=120

# Docker image tags are intentionally configurable from the outside.
QDRANT_IMAGE_TAG=v1.18.2
OPEN_WEBUI_IMAGE_TAG=v0.9.6
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_AUTH=true
