.DS_Store
.env
.venv/
venv/
.uv-cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.idea/
.vscode/

# Local service state
qdrant_storage/
open_webui_data/

# Dashboard local runtime state
data/dashboard/*.sqlite
data/dashboard/*.sqlite-*
data/dashboard/exports/

# Empty radar automation runs are runtime noise, not source history.
automations/ai-lab-radar/reports/*no-new-source-packet.md
automations/ai-lab-radar/reports/*no-new-approved-source-packet.md

# Heavy local artifacts stay out of git by default.
data/raw/*
!data/raw/README.md
data/parsed/*
!data/parsed/README.md
data/chunked/*
!data/chunked/README.md
data/eval/*
!data/eval/README.md
data/eval_results/*
!data/eval_results/.gitkeep
data/synthetic/*
!data/synthetic/README.md
models/base/*
!models/base/README.md
models/quantized/*
!models/quantized/README.md
models/adapters/*
!models/adapters/README.md
models/embeddings/*
!models/embeddings/README.md
models/rerankers/*
!models/rerankers/README.md
experiments/*
!experiments/README.md
reports/benchmarks/*
!reports/benchmarks/README.md
reports/evals/*
!reports/evals/README.md
reports/postmortems/*
!reports/postmortems/README.md
.claude/
