{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth-install-policy-v1.schema.json",
  "title": "AI Lab OS Growth reviewed install policies v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policies"],
  "properties": {
    "schema_version": {"const": "growth-install-policy-v1"},
    "policies": {
      "type": "array",
      "items": {"$ref": "#/$defs/policy"}
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "host",
        "plugin_id",
        "marketplace",
        "marketplace_source",
        "marketplace_revision",
        "reviewed_version",
        "scope",
        "components",
        "auth_policy",
        "data_scope",
        "high_risk",
        "data_scope_ack_required",
        "threat_review_artifact",
        "threat_review_sha256",
        "threat_review_version",
        "threat_review_scope",
        "reviewed_at",
        "pin_mode"
      ],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "host": {"enum": ["codex", "claude"]},
        "plugin_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "marketplace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "marketplace_source": {"type": "string", "format": "uri", "pattern": "^https://"},
        "marketplace_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "reviewed_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"},
        "scope": {"enum": ["user", "project", "local"]},
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["agents", "apps", "commands", "connectors", "hooks", "lsp_servers", "mcp_servers", "skills"]
          }
        },
        "auth_policy": {"type": "string", "minLength": 1, "maxLength": 240},
        "data_scope": {"type": "string", "minLength": 1, "maxLength": 240},
        "high_risk": {"type": "boolean"},
        "data_scope_ack_required": {"type": "boolean"},
        "threat_review_artifact": {
          "type": ["string", "null"],
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.@+/-]*$"
        },
        "threat_review_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "threat_review_version": {"type": ["string", "null"]},
        "threat_review_scope": {"type": ["string", "null"]},
        "reviewed_at": {"type": "string", "format": "date"},
        "pin_mode": {"const": "immutable_marketplace_revision"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "components": {"contains": {"const": "connectors"}}
            }
          },
          "then": {
            "properties": {
              "high_risk": {"const": true},
              "data_scope_ack_required": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"high_risk": {"const": false}}},
          "then": {
            "properties": {"data_scope_ack_required": {"const": false}}
          }
        }
      ]
    }
  }
}
