{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth-catalog-v1.schema.json",
  "title": "AI Lab OS Growth Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_kind", "items"],
  "properties": {
    "schema_version": {"const": "growth-catalog-v1"},
    "catalog_kind": {"enum": ["skill", "extension", "learning"]},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:@-]{0,127}$"
    },
    "risk_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_exec",
        "fs",
        "network",
        "creds",
        "private_data",
        "writes",
        "hooks",
        "background",
        "provenance",
        "license",
        "version_pin",
        "rollback"
      ],
      "properties": {
        "code_exec": {"type": "string", "minLength": 1},
        "fs": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "creds": {"type": "string", "minLength": 1},
        "private_data": {"type": "string", "minLength": 1},
        "writes": {"type": "string", "minLength": 1},
        "hooks": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "version_pin": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalog_kind",
        "type",
        "name",
        "official",
        "provenance",
        "source_url",
        "availability",
        "review_date",
        "career_lenses",
        "practical_value",
        "marketability",
        "effort_tier",
        "cost",
        "prereqs",
        "capability_gaps",
        "risk_facts",
        "status",
        "review_state",
        "proof_artifact",
        "proof_project",
        "next_action",
        "inventory_aliases"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/safe_id"},
        "catalog_kind": {"enum": ["skill", "extension", "learning"]},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "official": {"type": ["boolean", "null"]},
        "provenance": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "availability": {
          "enum": ["available", "pending", "link_requires_verification", "unknown", "unavailable"]
        },
        "review_date": {"type": "string", "format": "date"},
        "career_lenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["AIA", "AUT", "MLD"]}
        },
        "practical_value": {"type": "string", "minLength": 1},
        "marketability": {"type": "string", "minLength": 1},
        "effort_tier": {"enum": ["1-3", "4-6", "7-10"]},
        "cost": {"type": ["string", "null"], "minLength": 1},
        "prereqs": {"type": "array", "items": {"type": "string"}},
        "capability_gaps": {"type": "array", "items": {"type": "string"}},
        "risk_facts": {"$ref": "#/$defs/risk_facts"},
        "status": {"enum": ["Now", "Next", "Later", "Watch", "Blocked"]},
        "review_state": {
          "enum": ["unreviewed", "metadata_reviewed", "trial_approved", "blocked", "retired"]
        },
        "proof_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9_.@+/-]*$"
        },
        "proof_project": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "inventory_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      }
    }
  }
}
